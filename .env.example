# Copie para .env e preencha com os valores reais (o .env NAO vai para o GitHub).
# DB_HOST = nome do servico do MySQL no docker-compose (rede interna do Docker)
DB_HOST=db
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=atividade4
# Senha do root do MySQL (usada so pelo container db, nunca pela aplicacao)
DB_ROOT_PASSWORD=
SECRET_KEY=
